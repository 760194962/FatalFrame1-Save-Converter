#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
1 VERSIONINFO FILEVERSION 1,1,0,0 PRODUCTVERSION 1,1,0,0
BEGIN BLOCK "StringFileInfo" BEGIN BLOCK "040904b0" BEGIN
 VALUE "FileDescription", "FatalFrame1 Save Converter (Fatal Frame Xbox JP/US save converter)"
 VALUE "ProductName", "FatalFrame1 Save Converter"
 VALUE "FileVersion", "1.1.0"
END END
BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END END
